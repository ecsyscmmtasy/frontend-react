//Циклы нужны, чтобы повторять код много раз.

for (let i = 0; i < 5; i++) {
    console.log(i);
}
//while работает пока условие true
let i = 0;

while (i < 5) {
    console.log(i);
    i++;
}


//do while-Сначала выполняет код, потом проверяет условие
let i = 0;

do {
    console.log(i);
    i++;
} while (i < 5);
//break Останавливает цикл.
for (let i = 0; i < 10; i++) {

    if (i === 5) {
        break;
    }

    console.log(i);
}

//continue Пропускает один шаг
for (let i = 0; i < 5; i++) {

    if (i === 2) {
        continue;
    }

    console.log(i);
}
